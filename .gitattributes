# Normalize text line endings
* text=auto

# Binary CAD / print files: no diffs, no line-ending conversion
*.FCStd binary
*.stl    binary
*.step   binary
*.stp    binary
*.3mf    binary
*.pdf    binary
*.png    binary
*.jpg    binary

# Vendored third-party files: not counted in GitHub language stats, no text diffs
third_party/** linguist-vendored -diff
third_party/README.md -linguist-vendored diff
